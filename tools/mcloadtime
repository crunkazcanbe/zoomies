#!/usr/bin/env python3
"""mcloadtime — where does your modpack's load time go?

Reads Forge's own stopwatch lines from logs/debug.log ("Bar Step: <stage> - <mod> took 1.234s",
"Bar Finished: <stage> took 1.234s") and prints the slowest stages and the slowest mods.

  mcloadtime                 # the latest launch in $MC_DIR (default ~/.minecraft)
  mcloadtime path/to/debug.log
"""
import collections, os, re, sys

LOG = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.environ.get("MC_DIR", os.path.expanduser("~/.minecraft")), "logs/debug.log")
STEP = re.compile(r"\[(\d\d:\d\d:\d\d)\].*Bar Step: (.+?) - (.+) took ([\d.]+)s")
DONE = re.compile(r"\[(\d\d:\d\d:\d\d)\].*Bar Finished: (.+?) took ([\d.]+)s")


def secs(t):
    h, m, s = map(int, t.split(":"))
    return h * 3600 + m * 60 + s


def main():
    per_mod = collections.Counter()           # mod -> seconds across all stages
    per_mod_stage = collections.Counter()     # (stage, mod) -> seconds
    stages = collections.Counter()            # top-level stage -> seconds
    steps = collections.Counter()
    first = last = None
    for line in open(LOG, errors="replace"):
        m = STEP.search(line)
        if m:
            t, stage, mod, s = m.groups()
            per_mod[mod] += float(s)
            per_mod_stage[(stage, mod)] += float(s)
            steps[stage] += 1
            first = first or t
            last = t
            continue
        m = DONE.search(line)
        if m and " - " not in m.group(2):
            t, stage, s = m.groups()
            stages[stage] += float(s)
            first = first or t
            last = t
    if not first:
        sys.exit("no Forge timing lines found in " + LOG)
    wall = secs(last) - secs(first)
    print(f"Load so far: {wall // 60}m {wall % 60}s  ({first} -> {last})\n")
    print("SLOWEST STAGES")
    for stage, s in stages.most_common(12):
        print(f"  {s:8.1f}s  {stage}  ({steps[stage]} steps)")
    print("\nSLOWEST MODS (all stages added up)")
    for mod, s in per_mod.most_common(25):
        worst = max((v, st) for (st, md), v in per_mod_stage.items() if md == mod)
        print(f"  {s:8.1f}s  {mod[:60]:60}  worst: {worst[1]} {worst[0]:.1f}s")


if __name__ == "__main__":
    main()
